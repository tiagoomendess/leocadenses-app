# Database (mysql:// URL). The app only needs data access; migrations use
# MIGRATION_DATABASE_URL when set (a user allowed to run DDL).
DATABASE_URL="mysql://user:password@127.0.0.1:3306/leocadenses"
MIGRATION_DATABASE_URL=""

# At least 32 random characters: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
SITE_URL="https://leocadenses.pt"

# Cloudflare R2 (S3 API). Development: LocalStack (http://localhost:4566, path style).
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_BUCKET="leocadenses"
R2_REGION="auto"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Public custom domain of the bucket; media URLs and /storage redirects point here
R2_PUBLIC_URL="https://cdn.leocadenses.pt"
R2_FORCE_PATH_STYLE="false"

# Cloudflare Turnstile (membership form). Test keys that always pass:
# 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Next game on the home page
DOMINGOASDEZ_URL="https://domingoasdez.com"
DOMINGOASDEZ_TEAM_ID="2"

# adapter-node (production only). The request origin (CSRF check of form posts) comes from the
# Host header and PROTOCOL_HEADER, which nginx sets; adapter-node 6 no longer reads ORIGIN.
# HOST=127.0.0.1
# PORT=3005
# PROTOCOL_HEADER=x-forwarded-proto
# ADDRESS_HEADER=CF-Connecting-IP
# BODY_SIZE_LIMIT=25M
